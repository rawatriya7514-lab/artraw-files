<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ====================================================================== -->
    <!-- Google Mobile Ads SDK Configuration — ArtFiles                        -->
    <!-- NOTE: Placeholder / Test AD_UNIT_IDs are used by default for dev.     -->
    <!-- Replace with production IDs in variants/*/res/values/adbom.xml later. -->
    <!-- ====================================================================== -->

    <integer name="google_play_services_version">12451000</integer>

    <!-- Master AdMob feature toggle -->
    <bool name="admob_enabled">true</bool>

    <!-- ====================================================================== -->
    <!-- App Open Ad — Shown on cold start (app launch)                        -->
    <!-- ====================================================================== -->
    <string name="admob_app_open_ad_unit_id" translatable="false">ca-app-pub-3940256099942544/3419835294</string>

    <!-- ====================================================================== -->
    <!-- Banner Ad — Persistent bottom banner on main screens                  -->
    <!-- ====================================================================== -->
    <string name="admob_banner_ad_unit_id" translatable="false">ca-app-pub-3940256099942544/6300978111</string>

    <!-- ====================================================================== -->
    <!-- Rewarded Ad — Grants reward on successful video completion            -->
    <!-- ====================================================================== -->
    <string name="admob_rewarded_ad_unit_id" translatable="false">ca-app-pub-3940256099942544/5224354917</string>

    <!-- ====================================================================== -->
    <!-- Interstitial Ad — Full-screen ad at natural transition points         -->
    <!-- ====================================================================== -->
    <string name="admob_interstitial_ad_unit_id" translatable="false">ca-app-pub-3940256099942544/1033173712</string>

    <!-- ====================================================================== -->
    <!-- Production IDs (commented out — uncomment and replace before release) -->
    <!-- ====================================================================== -->
    <!--
    <string name="admob_app_id" translatable="false">ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY</string>
    <string name="admob_app_open_ad_unit_id" translatable="false">ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY</string>
    <string name="admob_banner_ad_unit_id" translatable="false">ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY</string>
    <string name="admob_rewarded_ad_unit_id" translatable="false">ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY</string>
    <string name="admob_interstitial_ad_unit_id" translatable="false">ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY</string>
    -->

    <!-- AdMob App ID (used in AndroidManifest.xml meta-data) -->
    <string name="admob_app_id" translatable="false">ca-app-pub-3940256099942544~3347511713</string>

    <!-- AdMob XML Layout Attributes for AdView -->
    <declare-styleable name="AdsAttrs">
        <attr name="adSize" format="string" />
        <attr name="adSizes" format="string" />
        <attr name="adUnitId" format="string" />
    </declare-styleable>

    <!-- Translucent theme for Google Mobile Ads in-app browser/activity -->
    <style name="Theme.IAPTheme" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
