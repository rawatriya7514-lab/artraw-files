<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ====================================================================== -->
    <!-- Google Mobile Ads (AdMob) Production Configuration — Artfiles 1.0.0   -->
    <!-- ====================================================================== -->

    <integer name="google_play_services_version">12451000</integer>

    <!-- Master AdMob feature toggle -->
    <bool name="admob_enabled">true</bool>

    <!-- AdMob Production App ID -->
    <string name="admob_app_id" translatable="false">ca-app-pub-7925407604309207~4393395283</string>

    <!-- AdMob Production Banner Ad Unit ID -->
    <string name="admob_banner_ad_unit_id" translatable="false">ca-app-pub-7925407604309207/7795338269</string>

    <!-- AdMob Production Rewarded Ad Unit ID -->
    <string name="admob_rewarded_ad_unit_id" translatable="false">ca-app-pub-7925407604309207/4693787341</string>

    <!-- AdMob Production Interstitial Ad Unit ID -->
    <string name="admob_interstitial_ad_unit_id" translatable="false">ca-app-pub-7925407604309207/4693787341</string>

    <!-- AdMob App Open Ad Unit ID (Test fallback for cold start) -->
    <string name="admob_app_open_ad_unit_id" translatable="false">ca-app-pub-3940256099942544/3419835294</string>

    <!-- AdMob XML Layout Attributes for AdView -->
    <declare-styleable name="AdsAttrs">
        <attr name="adSize" format="string" />
        <attr name="adSizes" format="string" />
        <attr name="adUnitId" format="string" />
    </declare-styleable>

    <!-- Translucent theme for Google Mobile Ads in-app browser/activity -->
    <style name="Theme.IAPTheme" parent="android:Theme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
