<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ====================================================================== -->
    <!-- ARTFILES — Premium graphite & jewel-tone design system                 -->
    <!-- Light values in values/, dark values in values-night/                 -->
    <!-- ====================================================================== -->

    <style name="Theme.ArtrawFiles" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/aurora_primary</item>
        <item name="android:colorPrimaryDark">@color/aurora_background_deep</item>
        <item name="android:colorAccent">@color/aurora_secondary</item>
        <item name="android:windowBackground">@drawable/bg_heaven_gradient</item>
        <item name="android:colorBackground">@color/aurora_background_deep</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.ArtrawFiles</item>
        <item name="android:windowSplashScreenBackground">@color/aurora_background_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_vector</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/aurora_background_deep</item>
    </style>

    <!-- Kept for compatibility; BaseActivity applies the theme-aware base theme -->
    <style name="Theme.ArtrawFiles.Light" parent="Theme.ArtrawFiles">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.ArtrawFiles.Splash" parent="Theme.ArtrawFiles">
        <item name="android:windowBackground">@color/aurora_background_deep</item>
        <item name="android:windowSplashScreenBackground">@color/aurora_background_deep</item>
        <item name="android:windowSplashScreenAnimationDuration">400</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/aurora_background_deep</item>
    </style>

    <style name="Animation.ArtrawFiles" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close</item>
        <item name="android:windowEnterAnimation">@anim/activity_open</item>
        <item name="android:windowExitAnimation">@anim/activity_close</item>
    </style>

    <style name="Theme" parent="Theme.ArtrawFiles" />
    <style name="Widget" />
    <style name="Widget.ArtrawFiles" />

    <!-- ====================================================================== -->
    <!-- Typography: calm hierarchy, tight display tracking, airy body copy    -->
    <!-- ====================================================================== -->
    <style name="Widget.ArtrawFiles.Text">
        <item name="android:textColor">@color/aurora_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.ArtrawFiles.Text.Display" parent="Widget.ArtrawFiles.Text">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:lineHeight">40sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="Widget.ArtrawFiles.Text.Headline" parent="Widget.ArtrawFiles.Text.Display">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineHeight">33sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Widget.ArtrawFiles.Text.Title" parent="Widget.ArtrawFiles.Text.Display">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">25sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Widget.ArtrawFiles.Text.Body" parent="Widget.ArtrawFiles.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineHeight">21sp</item>
        <item name="android:lineSpacingExtra">1.5sp</item>
    </style>

    <style name="Widget.ArtrawFiles.Text.Caption" parent="Widget.ArtrawFiles.Text">
        <item name="android:textColor">@color/aurora_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineHeight">17sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.ArtrawFiles.Text.Label" parent="Widget.ArtrawFiles.Text">
        <item name="android:textColor">@color/aurora_text_tertiary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:lineHeight">14sp</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="Widget.ArtrawFiles.Text.Overline" parent="Widget.ArtrawFiles.Text.Label">
        <item name="android:textSize">9sp</item>
        <item name="android:lineHeight">13sp</item>
    </style>

    <!-- ====================================================================== -->
    <!-- Components                                                             -->
    <!-- ====================================================================== -->
    <style name="Widget.ArtrawFiles.Card">
        <item name="android:background">@drawable/bg_glass_clay_card</item>
    </style>

    <style name="Widget.ArtrawFiles.Card.Elevated">
        <item name="android:background">@drawable/bg_glass_clay_card_elevated</item>
    </style>

    <style name="Widget.ArtrawFiles.Card.Selected">
        <item name="android:background">@drawable/bg_glass_clay_card_selected</item>
    </style>

    <style name="Widget.ArtrawFiles.Button">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Widget.ArtrawFiles.Button.Primary" parent="Widget.ArtrawFiles.Button">
        <item name="android:background">@drawable/bg_glass_clay_button_primary</item>
        <item name="android:textColor">@color/aurora_on_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.ArtrawFiles.Button.Outlined" parent="Widget.ArtrawFiles.Button">
        <item name="android:background">@drawable/bg_glass_clay_button_outlined</item>
        <item name="android:textColor">@color/aurora_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.ArtrawFiles.Button.Accent" parent="Widget.ArtrawFiles.Button">
        <item name="android:background">@drawable/bg_glass_clay_button_accent</item>
        <item name="android:textColor">@color/aurora_on_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.ArtrawFiles.BottomNavItem">
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Widget.ArtrawFiles.BottomNavItem.Label">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineHeight">13sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.ArtrawFiles.CategoryCard">
        <item name="android:background">@drawable/bg_glass_category_card</item>
    </style>

    <style name="Widget.ArtrawFiles.FileItem">
        <item name="android:background">@drawable/bg_clay_file_item</item>
    </style>

    <style name="Widget.ArtrawFiles.FileItem.Selected">
        <item name="android:background">@drawable/bg_clay_file_item_selected</item>
    </style>

    <style name="Widget.ArtrawFiles.Dialog">
        <item name="android:background">@drawable/bg_clay_dialog</item>
    </style>

    <style name="Widget.ArtrawFiles.Toast">
        <item name="android:background">@drawable/bg_clay_dialog</item>
    </style>
</resources>
