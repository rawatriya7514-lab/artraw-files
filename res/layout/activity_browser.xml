<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Header Area with Status Bar Spacer -->
    <LinearLayout
        android:id="@+id/layoutTopBrowser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_dark">

        <!-- Status Bar Spacer (Guaranteed min 44dp, never clipped) -->
        <View
            android:id="@+id/statusBarSpacerBrowser"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <!-- Normal Top Bar -->
        <RelativeLayout
            android:id="@+id/toolbarNormal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/tvCurrentFolderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnBack"
                android:layout_toStartOf="@+id/layoutNormalActions"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="Storage"
                android:textColor="@color/text_primary_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutNormalActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnSearch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search" />

                <ImageView
                    android:id="@+id/btnSort"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_sort"
                    android:contentDescription="Sort" />

                <ImageView
                    android:id="@+id/btnViewToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_grid"
                    android:contentDescription="Toggle View" />

                <ImageView
                    android:id="@+id/btnNewFolder"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_new_folder"
                    android:contentDescription="New Folder" />

                <ImageView
                    android:id="@+id/btnRefresh"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="Refresh" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Contextual Selection Toolbar (Top) -->
        <RelativeLayout
            android:id="@+id/toolbarSelection"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface_elevated_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnCloseSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Close Selection" />

            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnCloseSelection"
                android:layout_toStartOf="@+id/layoutSelectionActions"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="0 selected"
                android:textColor="@color/text_primary_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutSelectionActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnActionSelectAll"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_select_all"
                    android:contentDescription="Select All" />

                <ImageView
                    android:id="@+id/btnActionCopy"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_copy"
                    android:contentDescription="Copy" />

                <ImageView
                    android:id="@+id/btnActionCut"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_cut"
                    android:contentDescription="Cut" />

                <ImageView
                    android:id="@+id/btnActionShare"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_share"
                    android:contentDescription="Share" />

                <ImageView
                    android:id="@+id/btnActionCompress"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_compress"
                    android:contentDescription="Compress to ZIP" />

                <ImageView
                    android:id="@+id/btnActionDelete"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="Delete" />

                <ImageView
                    android:id="@+id/btnActionMore"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more"
                    android:contentDescription="More" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Search Input Bar (Visible during search) -->
        <LinearLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@color/surface_dark"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColor="@color/text_primary_dark"
                android:textColorHint="@color/text_tertiary_dark"
                android:textSize="14sp"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_more"
                android:contentDescription="Clear" />
        </LinearLayout>

        <!-- PC-Style Address Bar (Windows Explorer / Desktop style) -->
        <LinearLayout
            android:id="@+id/layoutPcAddressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_address_bar"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_folder"
                android:tint="@color/artraw_crimson_accent"
                android:contentDescription="Path" />

            <TextView
                android:id="@+id/tvPcPathDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:text="/storage/emulated/0"
                android:textColor="@color/text_primary_dark"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:ellipsize="start" />

            <!-- Instant Copy Path Button right in the address bar -->
            <ImageView
                android:id="@+id/btnCopyCurrentPath"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_copy"
                android:contentDescription="Copy Current Path" />

            <!-- Direct Jump / Type Path Button right in the address bar -->
            <ImageView
                android:id="@+id/btnTypePath"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                android:contentDescription="Type Path" />
        </LinearLayout>
    </LinearLayout>

    <!-- Breadcrumb Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@color/bg_dark"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <HorizontalScrollView
            android:id="@+id/scrollBreadcrumbs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutBreadcrumbs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark" />

    <!-- Sticky Paste Toolbar (Visible when clipboard active) -->
    <RelativeLayout
        android:id="@+id/layoutPasteBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@color/surface_elevated_dark"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPasteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/layoutPasteButtons"
            android:layout_centerVertical="true"
            android:singleLine="true"
            android:text="2 files ready to paste"
            android:textColor="@color/text_primary_dark"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutPasteButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelPaste"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_outlined"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_secondary_dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnExecutePaste"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/action_paste"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main List Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listViewFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/border_dark"
            android:dividerHeight="0.5dp"
            android:clipToPadding="false"
            android:fastScrollEnabled="true" />

        <GridView
            android:id="@+id/gridViewFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:padding="8dp"
            android:horizontalSpacing="8dp"
            android:verticalSpacing="8dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_folder"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/state_empty"
                android:textColor="@color/text_secondary_dark"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Floating New Folder Action Button -->
        <LinearLayout
            android:id="@+id/fabNewFolder"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_button_primary"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_new_folder"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="New Folder"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Loading View -->
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/artraw_crimson"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom AdMob Banner Container in Browser (Sticky above navigation bar) -->
    <FrameLayout
        android:id="@+id/adViewContainerBrowser"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:minHeight="50dp"
        android:background="@color/surface_dark"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Sponsored"
            android:textColor="@color/text_tertiary_dark"
            android:textSize="10sp"
            android:letterSpacing="0.08" />
    </FrameLayout>
</LinearLayout>
