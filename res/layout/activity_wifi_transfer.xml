<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aurora_background_deep">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aurora_background_surface">

        <View
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/btnWifiBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="@drawable/ripple_aurora"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:tint="@color/aurora_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnWifiBack"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="WiFi File Transfer"
                android:textColor="@color/aurora_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Connection Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_aurora_glow_card"
        android:padding="24dp"
        android:layout_margin="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wireless Transfer"
            android:textColor="@color/aurora_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect your PC to the same WiFi network"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvWifiIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: --"
                android:textColor="@color/aurora_glow_teal"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="24dp" />

            <TextView
                android:id="@+id/tvWifiPort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Port: --"
                android:textColor="@color/aurora_glow_teal"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWifiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server stopped"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnWifiStartStop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_aurora_glow_button"
            android:text="Start Server"
            android:textColor="@color/aurora_on_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Instructions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aurora_background_elevated"
        android:padding="20dp"
        android:layout_margin="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to use:"
            android:textColor="@color/aurora_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Make sure your phone and PC are on the same WiFi network\n2. Tap 'Start Server' above\n3. Open a browser on your PC\n4. Go to: http://[IP]:[PORT]\n5. Browse and download files wirelessly"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

</LinearLayout>
