<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootImageViewer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_background_deep">

    <!-- Main Fullscreen Image -->
    <ImageView
        android:id="@+id/imgFullPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/content_photo" />

    <!-- Top Overlay Bar -->
    <RelativeLayout
        android:id="@+id/headerImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/aurora_overlay_scrim"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="8dp"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/btnBackImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/content_back"
            android:tint="@color/aurora_text_primary" />

        <TextView
            android:id="@+id/tvImageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBackImage"
            android:layout_toStartOf="@id/layoutImageActions"
            android:text="Photo Name"
            android:textColor="@color/aurora_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/layoutImageActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnShareImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ripple_aurora"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/content_share"
                android:tint="@color/aurora_text_primary" />

            <ImageView
                android:id="@+id/btnEditImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ripple_aurora"
                android:padding="12dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/content_edit"
                android:tint="@color/aurora_text_primary" />

            <ImageView
                android:id="@+id/btnDeleteImage"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/ripple_aurora"
                android:padding="12dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/content_delete"
                android:tint="@color/aurora_error" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Info Bar -->
    <LinearLayout
        android:id="@+id/bottomImageBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/aurora_overlay_scrim"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvImageInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1920x1080 • 2.4 MB"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvImageIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 of 1"
            android:textColor="@color/aurora_text_tertiary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
