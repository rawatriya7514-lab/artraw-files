<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aurora_background_deep">

    <!-- Header with Dedicated Status Bar Spacer -->
    <LinearLayout
        android:id="@+id/headerDeviceMonitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aurora_background_surface">

        <View
            android:id="@+id/statusBarSpacerMonitor"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/btnMonitorBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/content_back" />

            <TextView
                android:id="@+id/tvMonitorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnMonitorBack"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="Device Monitor"
                android:textStyle="bold"
                android:textColor="@color/aurora_text_primary"
                style="@style/Widget.ArtrawFiles.Text.Title" />

            <TextView
                android:id="@+id/tvLivePulse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="● LIVE"
                android:textColor="@color/aurora_success"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Tab Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aurora_background_elevated"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnTabCpu"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_aurora_button_primary"
                android:text="CPU &amp; RAM"
                android:textColor="@color/aurora_text_primary"
                android:textSize="12sp" android:textStyle="normal" />

            <Button
                android:id="@+id/btnTabThermal"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_aurora_button_outlined"
                android:text="Thermal &amp; Heat"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="12sp" android:textStyle="normal" />

            <Button
                android:id="@+id/btnTabUsage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_aurora_button_outlined"
                android:text="App Usage"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="12sp" android:textStyle="normal" />

            <Button
                android:id="@+id/btnTabSpecs"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_aurora_button_outlined"
                android:text="Device Specs"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="12sp" android:textStyle="normal" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/scrollMonitorContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================================================= -->
            <!-- SECTION 1: CPU & RAM MONITOR                              -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/layoutCpuContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- SoC Overview Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Processor &amp; Architecture"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProcessorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Qualcomm Snapdragon / ARMv8"
                        android:textColor="@color/aurora_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCpuArchitecture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="8 Cores • aarch64 • schedutil"
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="12sp" android:textStyle="normal" />
                </LinearLayout>

                <!-- Live CPU Cores Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-Time CPU Cores (Live Frequencies)"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerCpuCores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <!-- RAM Memory Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Memory (RAM)"
                            android:textColor="@color/aurora_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRamPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="62% Used"
                            android:textColor="@color/aurora_success"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <ProgressBar
                        android:id="@+id/progressRam"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="62"
                        android:progressTint="@color/aurora_primary" />

                    <TextView
                        android:id="@+id/tvRamDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Used: 4.8 GB / Total: 8.0 GB (3.2 GB Free)"
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="12sp" android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- SECTION 2: THERMAL & HEAT MONITOR                         -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/layoutThermalContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Current Temperature Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Battery &amp; Thermal State"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentThermalTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="36.5°C"
                        android:textColor="@color/aurora_success"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThermalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Normal Temperature • Health: Good ✓ • Discharging"
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="12sp" android:textStyle="normal" />

                    <TextView
                        android:id="@+id/tvBatteryDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Battery: 78% • 3920 mV • Li-poly"
                        android:textColor="@color/aurora_text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Thermal History Graph Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thermal Timeline (Kab Heat Hua Tha)"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPeakHeatSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Peak Heat: 44.5°C at 15:30"
                        android:textColor="@color/aurora_text_primary"
                        android:textSize="13sp" />

                    <com.artraw.files.ui.view.ThermalGraphView
                        android:id="@+id/thermalGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <!-- Heat Alert Log Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heat Spike History Log"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerHeatEvents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- SECTION 3: APP USAGE & SCREEN TIME                        -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/layoutUsageContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Permission Required Banner (if needed) -->
                <LinearLayout
                    android:id="@+id/cardUsagePermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usage Access Permission Required"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="To calculate exact screen time and show which apps you used, Android requires Usage Access permission."
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="12sp" android:textStyle="normal" />

                    <Button
                        android:id="@+id/btnGrantUsagePerm"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_aurora_button_primary"
                        android:text="Grant Usage Access"
                        android:textColor="@color/aurora_text_primary"
                        android:textSize="12sp" android:textStyle="normal" />
                </LinearLayout>

                <!-- Total Screen Time Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Total Screen Time"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalScreenTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="4h 32m"
                        android:textColor="@color/aurora_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAppsActiveCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Active apps used today"
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="12sp" android:textStyle="normal" />
                </LinearLayout>

                <!-- App Usage Bar Chart Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App Usage Distribution (Graph)"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.artraw.files.ui.view.UsageGraphView
                        android:id="@+id/usageGraphView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>

                <!-- App Usage Detailed List -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apps Ranked By Usage Time"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerAppUsageList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========================================================= -->
            <!-- SECTION 4: DEVICE SPECS & OS                              -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/layoutSpecsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_aurora_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System &amp; Hardware Identity"
                        android:textColor="@color/aurora_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSpecsModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Device: Model"
                        android:textColor="@color/aurora_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvSpecsAndroid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Android: 15 (API 35)"
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSpecsDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Display: 1080x2400 @ 120Hz"
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSpecsKernel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Kernel: Linux"
                        android:textColor="@color/aurora_text_secondary"
                        android:textSize="12sp" android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
