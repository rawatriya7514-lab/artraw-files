<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSplashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_background_deep">

    <!-- Centered Minimalist Typography Brand Display -->
    <LinearLayout
        android:id="@+id/layoutSplashBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <!-- Modern Clean Wordmark (No oversized logo) -->
        <TextView
            android:id="@+id/tvSplashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/aurora_text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:includeFontPadding="false" />

        <!-- Minimalist Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fast • Private • Storage"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.05"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Bottom Minimalist Privacy & Security Badge -->
    <LinearLayout
        android:id="@+id/layoutSplashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100% ON-DEVICE PROCESSING"
            android:textColor="@color/aurora_text_tertiary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.16" />
    </LinearLayout>
</FrameLayout>
