<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutSplashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_heaven_splash">

    <!-- Centered Artfiles Brand Identity -->
    <LinearLayout
        android:id="@+id/layoutSplashBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- App Icon with Sleek Matte Container -->
        <FrameLayout
            android:id="@+id/flSplashLogoCard"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/bg_splash_logo_container"
            android:padding="14dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_launcher"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <!-- Brand Name -->
        <TextView
            android:id="@+id/tvSplashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textColor="@color/aurora_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/app_tagline"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04" />

        <!-- Subtitle / Value Proposition -->
        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/aurora_text_tertiary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <!-- Bottom Minimalist Branding Footer -->
    <LinearLayout
        android:id="@+id/layoutSplashFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART • PRIVATE • LIGHTNING FAST"
            android:textColor="#5E6378"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.16" />
    </LinearLayout>

</FrameLayout>
