<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGridRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_aurora"
    android:padding="3dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/frameGridThumbnail"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_card_material"
            android:clipToOutline="true"
            android:layout_marginBottom="3dp">

            <ImageView
                android:id="@+id/imgGridIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_file" />

            <ImageView
                android:id="@+id/imgGridSelectBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:src="@drawable/ic_check_circle_outline"
                android:tint="@color/aurora_primary"
                android:background="@drawable/bg_aurora_category_badge"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgGridEncryptionBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:src="@drawable/ic_file"
                android:tint="@color/aurora_warning"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvGridFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textStyle="bold"
            android:textColor="@color/aurora_text_primary"
            android:textSize="11sp"
            style="@style/Widget.ArtrawFiles.Text.Caption" />

        <TextView
            android:id="@+id/tvGridFileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="10sp"
            style="@style/Widget.ArtrawFiles.Text.Caption" />
    </LinearLayout>

</FrameLayout>
