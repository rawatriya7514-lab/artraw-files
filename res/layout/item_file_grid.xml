<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutGridRoot"
    android:layout_width="match_parent"
    android:layout_height="134dp"
    android:background="@drawable/bg_card"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/frameGridThumbnail"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/imgGridIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_file" />

        <ImageView
            android:id="@+id/imgGridSelectBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGridFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/frameGridThumbnail"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="middle"
        android:textColor="@color/text_primary_dark"
        android:textSize="12sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/tvGridFileMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvGridFileName"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/text_secondary_dark"
        android:textSize="10sp" />
</RelativeLayout>
