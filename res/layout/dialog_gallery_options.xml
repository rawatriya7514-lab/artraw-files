<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_gallery_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_badge"
        android:alpha="0.4" />

    <!-- Sheet Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gallery Options"
                android:textColor="@color/gallery_text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Display engine, sorting &amp; AI tools"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_close"
            android:tint="@color/gallery_text_subtitle"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Option 1: Layout Engine -->
    <LinearLayout
        android:id="@+id/btnOptLayoutEngine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_grid"
            android:tint="@color/cyber_violet"
            android:contentDescription="Layout" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gallery Layout Engine"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staggered Masonry, Bento Hero Art or Compact Grid"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/gallery_text_subtitle"
            android:contentDescription="Open" />
    </LinearLayout>

    <!-- Option 2: Sort Media -->
    <LinearLayout
        android:id="@+id/btnOptSortMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_sort"
            android:tint="@color/cyber_cyan"
            android:contentDescription="Sort" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort Media Order"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date, File Size, Name, or Aspect Ratio"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/gallery_text_subtitle"
            android:contentDescription="Open" />
    </LinearLayout>

    <!-- Option 3: Full AI Rescan -->
    <LinearLayout
        android:id="@+id/btnOptAiRescan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/neon_amber"
            android:contentDescription="AI Scan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full AI Scan &amp; Re-Index"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extract blur, colors, OCR text and auto-tags"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 4: AI Assistant -->
    <LinearLayout
        android:id="@+id/btnOptAiAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/neon_pink"
            android:contentDescription="Assistant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open AI Assistant"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask questions in plain natural language"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 5: Private Vault -->
    <LinearLayout
        android:id="@+id/btnOptVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_lock"
            android:tint="@color/cyber_green"
            android:contentDescription="Vault" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Private Encrypted Vault"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AES-256 hidden file protection"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 6: Gallery Settings -->
    <LinearLayout
        android:id="@+id/btnOptSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/gallery_text_subtitle"
            android:contentDescription="Settings" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App &amp; Media Settings"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage storage, cache and permissions"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
