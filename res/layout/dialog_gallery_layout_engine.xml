<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_gallery_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_badge"
        android:alpha="0.4" />

    <!-- Sheet Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gallery Layout Engine"
                android:textColor="@color/gallery_text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Choose how your photos and art are arranged"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnLayoutEngineClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_close"
            android:tint="@color/gallery_text_subtitle"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Option 1: Staggered Masonry -->
    <LinearLayout
        android:id="@+id/btnLayoutMasonry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_grid"
            android:tint="@color/cyber_cyan"
            android:contentDescription="Masonry" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Staggered Masonry Grid"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preserves natural aspect ratios without cropping"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 2: Bento Hero Grid -->
    <LinearLayout
        android:id="@+id/btnLayoutBento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_sparkles"
            android:tint="@color/cyber_violet"
            android:contentDescription="Bento" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bento Featured Grid"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Highlights high-quality hero art cards"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 3: Classic 3 Columns -->
    <LinearLayout
        android:id="@+id/btnLayoutCompact3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_grid"
            android:tint="@color/neon_amber"
            android:contentDescription="3 Columns" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Classic Compact Grid (3 Columns)"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard balanced photo browsing"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 4: Classic 4 Columns -->
    <LinearLayout
        android:id="@+id/btnLayoutCompact4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_grid"
            android:tint="@color/cyber_green"
            android:contentDescription="4 Columns" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dense Grid (4 Columns)"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High-density overview for large libraries"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Option 5: Large 2 Columns -->
    <LinearLayout
        android:id="@+id/btnLayoutCompact2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_clay_file_item"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_clay_icon_badge"
            android:padding="9dp"
            android:src="@drawable/ic_image"
            android:tint="@color/neon_pink"
            android:contentDescription="2 Columns" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Large Detail View (2 Columns)"
                android:textColor="@color/gallery_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detailed previews with extra visibility"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
