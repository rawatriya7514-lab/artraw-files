<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardInfoSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gallery_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:elevation="16dp">

    <!-- Top Drag Handle Pill -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_gallery_exif_badge" />

    <!-- Header: Title & Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/btnSheetClose"
            android:layout_centerVertical="true"
            android:text="Details &amp; Specifications"
            android:textColor="@color/gallery_text_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle" />

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_close"
            android:tint="@color/aurora_text_secondary"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Path Copy Superpower Card (User Primary Focus) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gallery_exif_badge"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILE PATH"
            android:textColor="@color/cyber_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvSheetPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="/storage/emulated/0/DCIM/Camera/IMG_001.jpg"
            android:textColor="@color/gallery_text_title"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <!-- Quick Path Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSheetCopyPath"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_cyber_chip_active"
                android:text="Copy Full Path"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSheetCopyFolder"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_cyber_chip_inactive"
                android:text="Copy Folder"
                android:textColor="@color/gallery_text_title"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Technical Specifications 3-Column Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <!-- Dimensions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESOLUTION"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1920 × 1080"
                android:textColor="@color/gallery_text_title"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- File Size -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIZE"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2.4 MB"
                android:textColor="@color/gallery_text_title"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Date Taken -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Today"
                android:textColor="@color/gallery_text_title"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Camera EXIF Badges (Horizontal scroll) -->
    <TextView
        android:id="@+id/tvSheetExifHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CAMERA EXIF"
        android:textColor="@color/cyber_violet"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="6dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/layoutSheetExifBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badgeExifDevice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_gallery_exif_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Camera Device"
                android:textColor="@color/gallery_text_title"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgeExifAperture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_gallery_exif_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="f/1.8"
                android:textColor="@color/gallery_text_title"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgeExifShutter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_gallery_exif_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="1/250s"
                android:textColor="@color/gallery_text_title"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgeExifIso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_gallery_exif_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="ISO 100"
                android:textColor="@color/gallery_text_title"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgeExifFocal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gallery_exif_badge"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="24mm"
                android:textColor="@color/gallery_text_title"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Color Palette Swatches (Tap to copy hex code) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COLOR PALETTE"
        android:textColor="@color/cyber_amber"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:id="@+id/layoutSheetPaletteSwatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp" />

</LinearLayout>
