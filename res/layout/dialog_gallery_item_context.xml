<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_gallery_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill_badge"
        android:alpha="0.4" />

    <!-- Item Preview Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivContextThumbnail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_gallery_grid_item"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvContextFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="middle"
                android:text="IMG_20261106_142010.jpg"
                android:textColor="@color/gallery_text_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvContextFileMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="3.2 MB • 4032 × 3024 • Nov 6, 2026"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnContextClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_close"
            android:tint="@color/gallery_text_subtitle"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Superpower Highlight: Copy Absolute Path Button -->
    <LinearLayout
        android:id="@+id/btnContextCopyPath"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_cyber_chip_active"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_copy"
            android:tint="#FFFFFF"
            android:contentDescription="Copy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Copy Absolute File Path"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Secondary Copy Chips (Folder & File Name) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnContextCopyFolder"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_clay_file_item"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_folder"
                android:tint="@color/cyber_cyan"
                android:contentDescription="Folder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Copy Folder"
                android:textColor="@color/gallery_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnContextCopyName"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_clay_file_item"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_rename"
                android:tint="@color/cyber_violet"
                android:contentDescription="Name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Copy File Name"
                android:textColor="@color/gallery_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Actions List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Action: AI Details -->
        <LinearLayout
            android:id="@+id/btnContextAiDetails"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_clay_file_item"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sparkles"
                android:tint="@color/cyber_violet"
                android:contentDescription="AI" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="AI Intelligence &amp; Details"
                android:textColor="@color/gallery_text_title"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Action: Favorite -->
        <LinearLayout
            android:id="@+id/btnContextFavorite"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_clay_file_item"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivContextFavIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_heart_filled"
                android:tint="@color/neon_pink"
                android:contentDescription="Favorite" />

            <TextView
                android:id="@+id/tvContextFavText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Add to Favorites"
                android:textColor="@color/gallery_text_title"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Action: Move to Vault -->
        <LinearLayout
            android:id="@+id/btnContextVault"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_clay_file_item"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/cyber_green"
                android:contentDescription="Vault" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Move to Encrypted Vault"
                android:textColor="@color/gallery_text_title"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Action: Share -->
        <LinearLayout
            android:id="@+id/btnContextShare"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_clay_file_item"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_share"
                android:tint="@color/cyber_cyan"
                android:contentDescription="Share" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Share Media"
                android:textColor="@color/gallery_text_title"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Action: Delete -->
        <LinearLayout
            android:id="@+id/btnContextDelete"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_clay_file_item"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_delete"
                android:tint="#EF4444"
                android:contentDescription="Delete" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Delete File"
                android:textColor="#EF4444"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
