<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootArchiveViewer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aurora_background_deep">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/headerArchive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/aurora_background_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btnBackArchive"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/content_back" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/btnBackArchive"
            android:layout_toStartOf="@id/layoutArchiveActions"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvArchiveName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="archive.zip"
                android:textColor="@color/text_primary_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvArchiveSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 files • 0 B"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutArchiveActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExtractAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_aurora_button_primary"
                android:text="Extract All"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- File List Inside Archive -->
    <ListView
        android:id="@+id/listArchiveEntries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/aurora_outline"
        android:dividerHeight="1dp"
        android:padding="8dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvArchiveEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Reading archive..."
        android:textColor="@color/aurora_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
