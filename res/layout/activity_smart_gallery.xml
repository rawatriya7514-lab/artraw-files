<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gallery_bg_canvas">

    <!-- Top Section (Header, Search, Stats, Memories Carousel, Filters) -->
    <LinearLayout
        android:id="@+id/layoutGalleryHeaderArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:background="@color/gallery_bg_canvas">

        <View
            android:id="@+id/statusBarSpacerGallery"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- App Bar: Editorial Title & Action Icons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/btnGalleryBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="11dp"
                android:background="@drawable/ripple_aurora"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/gallery_text_title"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnGalleryBack"
                android:layout_toStartOf="@+id/layoutGalleryTopActions"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGalleryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ArtFiles Gallery"
                    android:textStyle="bold"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="17sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvGalleryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Fast Media Engine • 0ms"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutGalleryTopActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <!-- Dynamic Grid / Bento / Masonry Engine Toggle -->
                <ImageView
                    android:id="@+id/btnGalleryColumns"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="1dp"
                    android:padding="9dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_grid"
                    android:tint="@color/gallery_text_title"
                    android:contentDescription="Toggle Layout Engine" />

                <!-- Quick Sort Button (Date, Size, Name, Aspect Ratio) -->
                <ImageView
                    android:id="@+id/btnGallerySort"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="1dp"
                    android:padding="9dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_sort"
                    android:tint="@color/gallery_text_title"
                    android:contentDescription="Quick Sort" />

                <!-- Multi-Select Mode -->
                <ImageView
                    android:id="@+id/btnGallerySelectAll"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="1dp"
                    android:padding="9dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_check_circle_outline"
                    android:tint="@color/gallery_text_title"
                    android:contentDescription="Select Mode" />

                <!-- More Options -->
                <ImageView
                    android:id="@+id/btnGalleryMore"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="9dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_more"
                    android:tint="@color/gallery_text_title"
                    android:contentDescription="More Options" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Advanced AI Search Bar with Glassmorphic Styling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/layoutGallerySearchBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_cyber_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_sparkles"
                    android:tint="@color/cyber_violet"
                    android:contentDescription="AI Search" />

                <EditText
                    android:id="@+id/etGalleryAiSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:hint="Search photos, videos, tags…"
                    android:textColorHint="@color/aurora_text_tertiary"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageView
                    android:id="@+id/btnGallerySearchClear"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/aurora_text_tertiary"
                    android:visibility="gone"
                    android:contentDescription="Clear Search" />

                <ImageView
                    android:id="@+id/btnGalleryHeaderAssistant"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:background="@drawable/bg_cyber_chip_active"
                    android:src="@drawable/ic_auto_awesome"
                    android:tint="#FFFFFF"
                    android:contentDescription="Ask AI" />

            </LinearLayout>
        </LinearLayout>

        <!-- Refined Editorial Stats Strip (Hidden by default to save 32dp vertical space) -->
        <LinearLayout
            android:id="@+id/bannerGalleryLiveStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_gallery_exif_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStatPhotos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 Photos"
                android:textColor="@color/gallery_text_title"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/gallery_card_border" />

            <TextView
                android:id="@+id/tvStatVideos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 Videos"
                android:textColor="@color/cyber_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/gallery_card_border" />

            <TextView
                android:id="@+id/tvStatAudio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 Audio"
                android:textColor="@color/neon_pink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/gallery_card_border" />

            <TextView
                android:id="@+id/tvStatDocs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 Docs"
                android:textColor="@color/cyber_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top "Memories / Featured Art" Horizontal Snapping Hero Carousel -->
        <HorizontalScrollView
            android:id="@+id/scrollGalleryMemories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/layoutGalleryMemories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Quick AI Suggestions Horizontal Scroll (Clean Text Pills - Expands on search focus) -->
        <HorizontalScrollView
            android:id="@+id/scrollGallerySuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipSuggMountains"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Mountains"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggRedCar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Red Car"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggDog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Pets &amp; Animals"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggDocuments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Documents &amp; Receipts"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggScreenshots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Screenshots"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggBest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Best Quality"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggBlurry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Blurry &amp; Out of Focus"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggDuplicates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Duplicates"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipSuggDiwali"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="Diwali &amp; Festivals"
                    android:textColor="@color/gallery_text_title"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Category Filter Pills (Clean High-Contrast Tabs) -->
        <HorizontalScrollView
            android:id="@+id/scrollGalleryCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:background="@color/gallery_bg_canvas">

            <LinearLayout
                android:id="@+id/layoutGalleryCategoryPills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabCatAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_active"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="All Media"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabCatPhotos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Photos"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Camera"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Videos"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatScreenshots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Screenshots"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Favorites"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <!-- RAW / ART Filter Chip -->
                <TextView
                    android:id="@+id/tabCatRawArt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="RAW &amp; Art"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <!-- VAULT Filter Chip -->
                <TextView
                    android:id="@+id/tabCatVault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Vault"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Audio &amp; Music"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatDocuments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Documents"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatDownloads"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Downloads"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatCollections"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Collections"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tabCatDuplicates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cyber_chip_inactive"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Duplicates"
                    android:textColor="@color/gallery_text_subtitle"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Main Content Grid Area -->
    <FrameLayout
        android:id="@+id/layoutGalleryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutGalleryHeaderArea"
        android:layout_above="@id/adViewContainerGallery">

        <!-- Photo / Media GridView with Dynamic Density -->
        <GridView
            android:id="@+id/gridGalleryMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:paddingTop="2dp"
            android:paddingBottom="72dp"
            android:horizontalSpacing="2dp"
            android:verticalSpacing="2dp"
            android:clipToPadding="false"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="visible" />

        <!-- AI Collections List View -->
        <ScrollView
            android:id="@+id/scrollGalleryCollections"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutCollectionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutGalleryEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_sparkles"
                android:tint="@color/cyber_violet"
                android:alpha="0.4"
                android:contentDescription="Empty" />

            <TextView
                android:id="@+id/tvGalleryEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No media found"
                android:textColor="@color/gallery_text_title"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGalleryEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Try another AI search query or tab filter"
                android:textColor="@color/gallery_text_subtitle"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGalleryReindex"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_cyber_chip_active"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Scan &amp; Index Gallery"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Loading Progress Bar -->
        <ProgressBar
            android:id="@+id/progressGalleryLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/cyber_violet"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Multi-Select Contextual Floating Bottom Dock -->
    <LinearLayout
        android:id="@+id/layoutGallerySelectionDock"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_above="@id/adViewContainerGallery"
        android:background="@color/gallery_glass_dock"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvGallerySelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 selected"
            android:textColor="@color/gallery_text_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 1-TAP BATCH COPY PATHS (CORE REQUIREMENT) -->
        <ImageView
            android:id="@+id/btnSelectionCopyPaths"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_copy"
            android:tint="@color/neon_green"
            android:contentDescription="Copy All Selected Paths" />

        <!-- Move Selected to Vault -->
        <ImageView
            android:id="@+id/btnSelectionVault"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_lock"
            android:tint="@color/neon_amber"
            android:contentDescription="Move to Vault" />

        <!-- Share Selected -->
        <ImageView
            android:id="@+id/btnSelectionShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_share"
            android:tint="@color/cyber_cyan"
            android:contentDescription="Share" />

        <!-- Favorite Selected -->
        <ImageView
            android:id="@+id/btnSelectionFavorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_star_filled"
            android:tint="@color/neon_amber"
            android:contentDescription="Favorite" />

        <!-- Delete Selected -->
        <ImageView
            android:id="@+id/btnSelectionDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_delete"
            android:tint="@color/neon_pink"
            android:contentDescription="Delete" />

        <!-- Close Selection -->
        <ImageView
            android:id="@+id/btnSelectionClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:background="@drawable/ripple_aurora"
            android:src="@drawable/ic_close"
            android:tint="@color/aurora_text_secondary"
            android:contentDescription="Close Selection" />
    </LinearLayout>

    <!-- Floating AI Assistant FAB (Hidden to keep photos unobstructed) -->
    <LinearLayout
        android:id="@+id/fabGalleryAssistant"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_cyber_floating_fab"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sparkles"
            android:tint="#FFFFFF"
            android:contentDescription="Ask AI" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Ask AI"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom AdMob Banner Container -->
    <FrameLayout
        android:id="@+id/adViewContainerGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_alignParentBottom="true"
        android:background="@color/gallery_bg_canvas"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="SPONSORED"
            android:textColor="@color/gallery_text_subtitle"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12" />
    </FrameLayout>

</RelativeLayout>
