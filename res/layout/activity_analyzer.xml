<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_dark"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/btnAnalyzerBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnAnalyzerBack"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="@string/nav_analysis"
            android:textColor="@color/text_primary_dark"
            android:textSize="17sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Tabs / Section selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/surface_elevated_dark">

        <TextView
            android:id="@+id/tabLargeFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/action_large_files"
            android:textColor="@color/artraw_crimson_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDuplicates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/action_duplicates"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Large Files Container -->
        <LinearLayout
            android:id="@+id/layoutLargeFilesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ListView
                android:id="@+id/listViewLargeFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/border_dark"
                android:dividerHeight="0.5dp" />
        </LinearLayout>

        <!-- Duplicates Container -->
        <LinearLayout
            android:id="@+id/layoutDuplicatesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cryptographic Duplicate Detection"
                    android:textColor="@color/text_primary_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Finds identical files using a two-step verification process: preliminary size grouping followed by explicit SHA-256 cryptographic verification."
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnStartDuplicateScan"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Scan for Duplicates"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuplicateProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/artraw_crimson_accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/listViewDuplicates"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/border_dark"
                android:dividerHeight="0.5dp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressAnalyzer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/artraw_crimson"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
