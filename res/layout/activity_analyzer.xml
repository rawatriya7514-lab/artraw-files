<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_heaven_gradient">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerAnalyzer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aurora_background_surface">

        <View
            android:id="@+id/statusBarSpacerAnalyzer"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/btnAnalyzerBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:background="@drawable/ripple_aurora"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/content_back"
                android:tint="@color/aurora_text_primary" />

            <TextView
                android:id="@+id/tvAnalyzerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnAnalyzerBack"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:text="@string/nav_analysis"
                android:textStyle="bold"
                android:textColor="@color/aurora_text_primary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvAnalyzerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnAnalyzerBack"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_below="@id/tvAnalyzerTitle"
                android:text="Storage insights &amp; cleanup"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="11sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Tab Bar -->
    <LinearLayout
        android:id="@+id/tabBarAnalyzer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/aurora_background_surface"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tabLargeFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/action_large_files"
            android:textColor="@color/aurora_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_glass_clay_button_primary" />

        <TextView
            android:id="@+id/tabDuplicates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="@string/action_duplicates"
            android:textColor="@color/aurora_text_secondary"
            android:textStyle="normal"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_glass_clay_button_outlined" />

        <TextView
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="Apps"
            android:textColor="@color/aurora_text_secondary"
            android:textStyle="normal"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_glass_clay_button_outlined" />

        <TextView
            android:id="@+id/tabWifi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="WiFi"
            android:textColor="@color/aurora_text_secondary"
            android:textStyle="normal"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_glass_clay_button_outlined" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Large Files Container -->
        <LinearLayout
            android:id="@+id/layoutLargeFilesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ListView
                android:id="@+id/listViewLargeFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/aurora_divider"
                android:dividerHeight="0.5dp"
                android:clipToPadding="false"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Duplicates Container -->
        <LinearLayout
            android:id="@+id/layoutDuplicatesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_clay_card"
                android:padding="16dp"
                android:layout_margin="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Duplicate Cleaner"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_text_primary"
                    style="@style/Widget.ArtrawFiles.Text.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Find identical files across storage. Auto-select copies to free space."
                    android:textColor="@color/aurora_text_secondary"
                    android:textSize="13sp"
                    android:lineHeight="18sp" />

                <Button
                    android:id="@+id/btnStartDuplicateScan"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_clay_button_primary"
                    android:text="Scan for Duplicates"
                    android:textColor="@color/aurora_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuplicateProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/aurora_primary"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutDuplicateSelectionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnAutoSelectDuplicates"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_glass_clay_button_outlined"
                    android:text="Auto-Select Copies"
                    android:textColor="@color/aurora_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSelectAllDuplicates"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_clay_button_outlined"
                    android:text="Select All"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDeselectAllDuplicates"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_clay_button_outlined"
                    android:text="Deselect"
                    android:textColor="@color/aurora_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/listViewDuplicates"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/aurora_divider"
                android:dividerHeight="0.5dp"
                android:clipToPadding="false"
                android:padding="8dp" />

            <LinearLayout
                android:id="@+id/layoutDuplicateDeleteBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_clay_card"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_margin="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDuplicateSelectedSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 items selected"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDeleteSelectedDuplicates"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glass_clay_button_primary"
                    android:text="Delete Selected"
                    android:textColor="@color/aurora_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Apps Storage Container -->
        <LinearLayout
            android:id="@+id/layoutAppsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_clay_card"
                android:padding="16dp"
                android:layout_margin="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Installed Apps"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_text_primary"
                    style="@style/Widget.ArtrawFiles.Text.Title" />

                <ListView
                    android:id="@+id/listViewApps"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/aurora_divider"
                    android:dividerHeight="0.5dp"
                    android:clipToPadding="false"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- WiFi Transfer Container -->
        <LinearLayout
            android:id="@+id/layoutWifiView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_clay_card"
                android:padding="24dp"
                android:layout_margin="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi Transfer"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_text_primary"
                    style="@style/Widget.ArtrawFiles.Text.Title"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connect PC to same WiFi. Start server and browse files wirelessly."
                    android:textColor="@color/aurora_text_secondary"
                    android:textSize="13sp"
                    android:lineHeight="18sp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvWifiIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP: --"
                        android:textColor="@color/aurora_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="24dp" />

                    <TextView
                        android:id="@+id/tvWifiPort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Port: --"
                        android:textColor="@color/aurora_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWifiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Server stopped"
                    android:textColor="@color/aurora_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/btnOpenWifiTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_glass_clay_button_primary"
                    android:text="Start Server"
                    android:textColor="@color/aurora_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressAnalyzer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/aurora_primary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>