<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/aurora_background_deep">

    <!-- Top Bar with Dedicated Status Bar Spacer -->
    <LinearLayout
        android:id="@+id/headerAnalyzer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aurora_background_surface">

        <!-- Status Bar Spacer (Guaranteed min 44dp, never clipped) -->
        <View
            android:id="@+id/statusBarSpacerAnalyzer"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/btnAnalyzerBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="@drawable/ripple_aurora"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:tint="@color/aurora_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnAnalyzerBack"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="@string/nav_analysis"
                android:textColor="@color/aurora_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Tabs / Section selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/aurora_background_elevated">

        <TextView
            android:id="@+id/tabLargeFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/action_large_files"
            android:textColor="@color/aurora_glow_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDuplicates"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/action_duplicates"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabApps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Apps"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabWifi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="WiFi"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Large Files Container -->
        <LinearLayout
            android:id="@+id/layoutLargeFilesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ListView
                android:id="@+id/listViewLargeFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/aurora_divider"
                android:dividerHeight="0.5dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Duplicates Container -->
        <LinearLayout
            android:id="@+id/layoutDuplicatesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_aurora_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cryptographic Duplicate Cleaner"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Scan your device to find identical duplicate files. Auto-select extra copies and free up storage instantly."
                    android:textColor="@color/aurora_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnStartDuplicateScan"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_aurora_glow_button"
                    android:text="Scan for Duplicates"
                    android:textColor="@color/aurora_on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuplicateProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/aurora_glow_teal"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <!-- Quick Selection Actions -->
            <LinearLayout
                android:id="@+id/layoutDuplicateSelectionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnAutoSelectDuplicates"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_aurora_button_outlined"
                    android:text="Auto-Select Copies"
                    android:textColor="@color/aurora_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSelectAllDuplicates"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_aurora_button_outlined"
                    android:text="Select All"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDeselectAllDuplicates"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_aurora_button_outlined"
                    android:text="Deselect"
                    android:textColor="@color/aurora_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ListView
                android:id="@+id/listViewDuplicates"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/aurora_divider"
                android:dividerHeight="0.5dp"
                android:clipToPadding="false" />

            <!-- Sticky Bottom Delete Bar -->
            <LinearLayout
                android:id="@+id/layoutDuplicateDeleteBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_aurora_card"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDuplicateSelectedSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 duplicates selected"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDeleteSelectedDuplicates"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_aurora_button_primary"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Delete Selected"
                    android:textColor="@color/aurora_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Apps Storage Container -->
        <LinearLayout
            android:id="@+id/layoutAppsView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Installed Apps Storage"
                android:textColor="@color/aurora_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="16dp" />

            <ListView
                android:id="@+id/listViewApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/aurora_divider"
                android:dividerHeight="0.5dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- WiFi Transfer Container -->
        <LinearLayout
            android:id="@+id/layoutWifiView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi File Transfer"
                android:textColor="@color/aurora_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:padding="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start a wireless server to transfer files between your phone and PC over WiFi.\n\nMake sure both devices are on the same WiFi network.\n\nTap 'Open WiFi Transfer' to launch the server."
                android:textColor="@color/aurora_text_secondary"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:lineSpacingExtra="4dp" />

            <Button
                android:id="@+id/btnOpenWifiTransfer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:background="@drawable/bg_aurora_glow_button"
                android:text="Open WiFi Transfer"
                android:textColor="@color/aurora_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressAnalyzer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/aurora_glow_teal"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
