<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_heaven_gradient">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/headerCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aurora_background_surface">

        <View
            android:id="@+id/statusBarSpacerCategory"
            android:layout_width="match_parent"
            android:layout_height="44dp" />

        <RelativeLayout
            android:id="@+id/toolbarCatNormal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/btnCatBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="9dp"
                android:background="@drawable/ripple_aurora"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/content_back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnCatBack"
                android:layout_toStartOf="@+id/layoutCatActions"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textStyle="bold"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvCatItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 files"
                    android:textColor="@color/aurora_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCatActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnCatSelectMode"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_check_circle_outline"
                    android:tint="@color/aurora_text_primary"
                    android:contentDescription="@string/content_select_all" />

                <ImageView
                    android:id="@+id/btnCatViewToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_grid"
                    android:contentDescription="@string/content_toggle_view" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Selection Category Toolbar -->
        <RelativeLayout
            android:id="@+id/toolbarCatSelection"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/aurora_background_elevated"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnCatCloseSelection"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:background="@drawable/ripple_aurora"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/content_close_selection" />

            <TextView
                android:id="@+id/tvCatSelectionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnCatCloseSelection"
                android:layout_toStartOf="@+id/layoutCatSelectionActions"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:text="0 selected"
                android:textColor="@color/aurora_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutCatSelectionActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnCatActionSelectAll"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_select_all"
                    android:contentDescription="@string/content_select_all" />

                <ImageView
                    android:id="@+id/btnCatActionCopy"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_copy"
                    android:contentDescription="@string/content_copy" />

                <ImageView
                    android:id="@+id/btnCatActionCut"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_cut"
                    android:contentDescription="@string/content_move" />

                <ImageView
                    android:id="@+id/btnCatActionShare"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_share"
                    android:contentDescription="@string/content_share" />

                <ImageView
                    android:id="@+id/btnCatActionDelete"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:background="@drawable/ripple_aurora"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="@string/content_delete" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Archive Capability Banner -->
    <LinearLayout
        android:id="@+id/layoutArchiveBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/aurora_background_elevated"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/archive_notice_zip"
            android:textColor="@color/aurora_success"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/archive_notice_unsupported"
            android:textColor="@color/aurora_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listViewCatFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/aurora_outline"
            android:dividerHeight="0.5dp"
            android:clipToPadding="false" />

        <GridView
            android:id="@+id/gridViewCatFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:padding="4dp"
            android:horizontalSpacing="4dp"
            android:verticalSpacing="4dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutCatEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_file"
                android:alpha="0.25" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/state_empty"
                android:textColor="@color/aurora_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressCatLoading"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/aurora_primary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Persistent Bottom Banner Ad -->
    <FrameLayout
        android:id="@+id/adViewContainerCategory"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:minHeight="50dp"
        android:background="@color/aurora_background_surface"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Sponsored"
            android:textColor="@color/aurora_text_tertiary"
            android:textSize="10sp"
            android:letterSpacing="0.08" />
    </FrameLayout>
</LinearLayout>
