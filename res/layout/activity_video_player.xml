<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootVideoPlayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- VideoView Centered -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Overlay Controls Container -->
    <RelativeLayout
        android:id="@+id/layoutVideoControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/aurora_overlay_scrim">

        <!-- Top Bar -->
        <RelativeLayout
            android:id="@+id/headerVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="36dp"
            android:paddingBottom="8dp"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/btnBackVideo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/content_back" />

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/btnBackVideo"
                android:layout_toStartOf="@id/btnShareVideo"
                android:text="Video Title"
                android:textStyle="bold"
                android:textColor="@color/aurora_text_primary"
                style="@style/Widget.ArtrawFiles.Text.Title"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/btnShareVideo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/content_share" />
        </RelativeLayout>

        <!-- Center Controls: Replay 10, Play/Pause, Forward 10 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnReplay10Video"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_replay_10"
                android:contentDescription="@string/content_refresh" />

            <FrameLayout
                android:id="@+id/btnPlayPauseVideo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_aurora_button_primary">

                <ImageView
                    android:id="@+id/imgPlayPauseVideo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:contentDescription="@string/content_play_pause" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnForward10Video"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_forward_10"
                android:contentDescription="@string/content_forward_10" />
        </LinearLayout>

        <!-- Bottom Bar: Timeline & Duration -->
        <LinearLayout
            android:id="@+id/bottomVideoBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <SeekBar
                android:id="@+id/seekBarVideo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/aurora_text_secondary"
                android:progressTint="@color/aurora_primary"
                android:thumbTint="@color/aurora_primary" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvVideoCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="0:00"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvVideoTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="0:00"
                    android:textColor="@color/aurora_text_primary"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
