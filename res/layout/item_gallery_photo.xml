<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPhotoRoot"
    android:layout_width="match_parent"
    android:layout_height="124dp"
    android:layout_margin="3dp"
    android:background="@drawable/bg_gallery_card"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivGalleryThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/content_photo" />

    <!-- Favorite Star Badge -->
    <ImageView
        android:id="@+id/ivGalleryFavBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:padding="2dp"
        android:src="@drawable/ic_star_filled"
        android:tint="@color/cyber_amber"
        android:visibility="gone"
        android:contentDescription="Favorite" />

    <!-- Video Indicator & Duration Badge -->
    <LinearLayout
        android:id="@+id/badgeGalleryVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge_video"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_play"
            android:tint="#FFFFFF"
            android:contentDescription="Video" />

        <TextView
            android:id="@+id/tvGalleryVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="0:00"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- AI Tag / Category Pill Badge -->
    <TextView
        android:id="@+id/tvGalleryAiBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge_video"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Selection Checkbox -->
    <ImageView
        android:id="@+id/ivGallerySelectionCheck"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/ripple_aurora"
        android:src="@drawable/ic_check_circle_outline"
        android:tint="@color/aurora_primary"
        android:visibility="gone"
        android:contentDescription="Select" />

</FrameLayout>
