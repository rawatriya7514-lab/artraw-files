<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOnboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/aurora_background_deep">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_storage" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/app_name"
        android:textStyle="bold"
        android:textColor="@color/aurora_text_primary"
        style="@style/Widget.ArtrawFiles.Text.Display" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/app_tagline"
        android:textColor="@color/aurora_text_secondary"
        style="@style/Widget.ArtrawFiles.Text.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:background="@drawable/bg_aurora_card"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_title"
            android:textStyle="bold"
            android:textColor="@color/aurora_primary"
            style="@style/Widget.ArtrawFiles.Text.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/perm_desc"
            android:textColor="@color/aurora_text_secondary"
            style="@style/Widget.ArtrawFiles.Text.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pref_privacy_pledge"
            android:textColor="@color/aurora_success"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnOnboardingGrant"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_aurora_button_primary"
        android:text="@string/perm_btn_grant"
        android:textColor="@color/aurora_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
