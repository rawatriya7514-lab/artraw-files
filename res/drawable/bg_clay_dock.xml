<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Drop Shadow -->
    <item android:top="4dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_hard" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Top Cyber Bevel -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#212435" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#33A855F7" />
        </shape>
    </item>
    <!-- Matte Clay Dock Surface -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#181A24"
                android:endColor="#101218"
                android:angle="270" />
            <corners android:radius="25dp" />
            <stroke android:width="1dp" android:color="@color/aurora_outline" />
        </shape>
    </item>
</layer-list>
