<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_hard" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_surface_elevated" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/aurora_outline_variant" />
        </shape>
    </item>
</layer-list>
