<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile Matte Clay Material Card with Subtle Drop Shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="2dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/aurora_shadow_soft" />
        </shape>
    </item>

    <item
        android:top="0dp"
        android:bottom="2dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/aurora_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_outline" />
        </shape>
    </item>
</layer-list>
