<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected clay card: crimson tinted shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4DE53935" />
            <corners android:radius="14dp" />
            <padding android:left="0dp" android:top="0dp" android:right="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <!-- Selected surface: darker matte with crimson stroke -->
    <item android:left="0dp" android:top="0dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1F1414" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/aurora_primary" />
        </shape>
    </item>
</layer-list>
