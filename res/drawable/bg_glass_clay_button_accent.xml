<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:startColor="@color/aurora_accent_blue" android:endColor="#0066CC" android:angle="45" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
