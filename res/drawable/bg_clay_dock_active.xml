<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Neon Glow Shadow -->
    <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#4DA855F7" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Vibrant Glowing Neon Clay Surface -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#3B1854"
                android:endColor="#2A1040"
                android:angle="270" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#A855F7" />
        </shape>
    </item>
</layer-list>
