<?xml version="1.0" encoding="utf-8"?>
<!-- Tactile Elevated Chunky Clay Card with Cyberpunk Dual Shadow & Cyan/Violet Ambient Rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Soft Drop Shadow (4dp) -->
    <item
        android:top="4dp"
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/aurora_shadow_soft" />
        </shape>
    </item>

    <!-- Top Neon Ambient Bevel Rim -->
    <item
        android:top="0dp"
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1.2dp"
                android:color="#3306B6D4" />
            <gradient
                android:angle="270"
                android:startColor="#3306B6D4"
                android:endColor="#10A855F7" />
        </shape>
    </item>

    <!-- Matte Dark Clay Surface (Elevated) -->
    <item
        android:top="1dp"
        android:bottom="3dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="270"
                android:startColor="#202232"
                android:endColor="@color/aurora_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_outline_variant" />
        </shape>
    </item>
</layer-list>
