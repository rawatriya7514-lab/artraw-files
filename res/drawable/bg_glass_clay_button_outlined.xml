<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_primary_container" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_background_surface" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_outline" />
        </shape>
    </item>
</selector>
