<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/aurora_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_outline" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <gradient
                    android:angle="0"
                    android:endColor="@color/aurora_success"
                    android:centerColor="@color/aurora_secondary"
                    android:startColor="@color/aurora_primary" />
                <stroke
                    android:width="1dp"
                    android:color="@color/aurora_primary_glow" />
            </shape>
        </clip>
    </item>
</layer-list>
