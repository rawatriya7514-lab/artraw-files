<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_medium" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_primary_container" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/aurora_primary" />
        </shape>
    </item>
</layer-list>
