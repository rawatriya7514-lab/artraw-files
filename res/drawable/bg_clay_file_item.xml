<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow -->
    <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_soft" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Top Ambient Rim Bevel -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#212435" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#1FA855F7" />
        </shape>
    </item>
    <!-- Matte Clay Surface -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#181A24"
                android:endColor="#13151B"
                android:angle="270" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/aurora_outline" />
        </shape>
    </item>
</layer-list>
