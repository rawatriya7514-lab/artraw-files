<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res.android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000" />
            <corners android:radius="12dp" />
            <padding android:left="0dp" android:top="0dp" android:right="1dp" android:bottom="1dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_background_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="0.5dp" android:color="@color/aurora_outline" />
        </shape>
    </item>
</layer-list>
