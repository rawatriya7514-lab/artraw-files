<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_soft" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_surface" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/aurora_glass_border" />
        </shape>
    </item>
</layer-list>
