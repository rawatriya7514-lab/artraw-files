<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#0D0E14" />
            <stroke android:width="1.5dp" android:color="#80A855F7" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="@color/aurora_shadow_soft" />
                </shape>
            </item>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <gradient
                        android:type="linear"
                        android:startColor="#212435"
                        android:endColor="#13151B"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="@color/aurora_outline" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
