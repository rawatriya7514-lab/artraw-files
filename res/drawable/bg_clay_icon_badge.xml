<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_soft" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#2A2D40"
                android:endColor="#141620"
                android:angle="270" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#33A855F7" />
        </shape>
    </item>
</layer-list>
