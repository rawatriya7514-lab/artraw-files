<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Deep 3D Shadow -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 2. Neon Ambient Glow Rim -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#2600F2FE"
                android:startColor="#40A855F7"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1.5dp"
                android:color="#4DA855F7" />
        </shape>
    </item>
    <!-- 3. Inner Clay Surface -->
    <item
        android:bottom="3dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_background_surface" />
            <corners android:radius="17dp" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_outline" />
        </shape>
    </item>
</layer-list>
