<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Chunky Clay Deep Shadow -->
    <item android:top="4dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_hard" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 2. Dual Neon Cyber Bevel (Cyan-to-Violet Plasma Rim) -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#3306B6D4"
                android:endColor="#33A855F7"
                android:angle="315" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#4DA855F7" />
        </shape>
    </item>
    <!-- 3. Chunky Matte Clay Surface -->
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#212438"
                android:endColor="#181926"
                android:angle="270" />
            <corners android:radius="19dp" />
            <stroke android:width="1dp" android:color="#2A2D3D" />
        </shape>
    </item>
</layer-list>
