<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_medium" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/aurora_surface_variant"
                android:startColor="@color/aurora_background_surface"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/aurora_outline" />
        </shape>
    </item>
</layer-list>
