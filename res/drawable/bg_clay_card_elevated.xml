<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Elevated clay shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_shadow_medium" />
            <corners android:radius="14dp" />
            <padding android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp" />
        </shape>
    </item>
    <!-- Elevated matte clay surface -->
    <item android:left="0dp" android:top="0dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/aurora_background_elevated" />
            <corners android:radius="14dp" />
            <stroke android:width="0.5dp" android:color="@color/aurora_outline_variant" />
        </shape>
    </item>
</layer-list>
