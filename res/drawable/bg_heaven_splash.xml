<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Space Base Canvas -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#07080C" />
        </shape>
    </item>

    <!-- Subtle Centered Aurora Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="85%"
                android:centerX="50%"
                android:centerY="45%"
                android:startColor="#22283D"
                android:centerColor="#111420"
                android:endColor="#0007080C" />
        </shape>
    </item>

    <!-- Gentle Top Vignette Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#0D1018"
                android:endColor="#0007080C" />
        </shape>
    </item>
</layer-list>
