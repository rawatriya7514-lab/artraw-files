<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#60A855F7" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="#FF007F"
                android:startColor="#A855F7"
                android:type="linear" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1.8dp"
                android:color="#FF77BC" />
        </shape>
    </item>
</layer-list>
