<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.artraw.files"
    android:versionCode="3"
    android:versionName="1.2.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="35" />

    <!-- ====================================================================== -->
    <!-- Google Play Store Storage Policy Compliance: File Management App       -->
    <!-- ARTRAW Files core function is device file & folder management.         -->
    <!-- ====================================================================== -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Granular Media Category Access for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Legacy Storage Permissions for Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- User-initiated APK package inspection & installation -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Google Mobile Ads (AdMob) Network & Advertising Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Digital Wellbeing & App Usage Statistics Monitor -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ArtrawFiles"
        android:requestLegacyExternalStorage="true">

        <!-- Google Mobile Ads (AdMob) SDK Configuration -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7925407604309207~4393395283" />

        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent" />

        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BrowserActivity"
            android:exported="false"
            android:label="@string/nav_browse"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.CategoryActivity"
            android:exported="false"
            android:label="Category"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.AnalyzerActivity"
            android:exported="false"
            android:label="@string/nav_analysis"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.TextPreviewActivity"
            android:exported="false"
            android:label="Text Viewer"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/nav_settings"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.AudioPlayerActivity"
            android:exported="false"
            android:label="Music Player"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.VideoPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:label="Video Player"
            android:windowSoftInputMode="adjustResize|adjustPan" />

        <activity
            android:name=".ui.ImageViewerActivity"
            android:exported="false"
            android:label="Photo Viewer"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.ArchiveViewerActivity"
            android:exported="false"
            android:label="Archive Viewer"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="Get Started"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.DeviceMonitorActivity"
            android:exported="false"
            android:label="Device &amp; App Monitor"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <activity
            android:name=".ui.ImageEditorActivity"
            android:exported="false"
            android:label="Photo Editor"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize|adjustPan" />

        <activity
            android:name=".ui.WiFiTransferActivity"
            android:exported="false"
            android:label="WiFi Transfer"
            android:windowSoftInputMode="adjustResize|adjustPan"
            android:configChanges="orientation|screenSize|smallestScreenSize|uiMode" />

        <provider
            android:name=".preview.ArtrawFileProvider"
            android:authorities="com.artraw.files.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
